# Copy to .env (mode 0600). Never committed. scripts/secrets.sh loads these into cluster Secrets.
# Keep this file free of real values.

# This fork uses a ChatGPT subscription (make chatgpt-login), without a provider API key.
LLM_PROVIDER=chatgpt

# Optional provider keys for alternate configurations.
ANTHROPIC_API_KEY=
# Optional second-provider key for the fallback.
OPENAI_API_KEY=

# LiteLLM proxy admin key.
LITELLM_MASTER_KEY=
# LiteLLM encryption salt. Never change it once models have been added.
LITELLM_SALT_KEY=
# Password for LiteLLM's in-cluster Postgres.
LITELLM_DB_PASSWORD=
# Per-cluster LLM budget guard in USD (set a provider-side spend limit at or above this too).
LLM_BUDGET_USD=

# Grafana admin password (user is "admin"). For a local demo, "admin" keeps the login simple.
GRAFANA_ADMIN_PASSWORD=

# Optional Argo CD admin password (user is "admin"), for a local demo. Unset keeps the one
# Argo CD generates (make -s argocd-password prints whichever is live).
ARGOCD_ADMIN_PASSWORD=

# Shared token Argo CD Notifications sends to the bridge.
BRIDGE_WEBHOOK_TOKEN=
# API key HolmesGPT requires from the bridge (X-API-Key).
HOLMES_API_KEY=

# GitHub App for the bridge (slice 3). The key file must live outside this repo.
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_APP_KEY_PATH=

# Login of the person who approves promotion PRs on stage (never committed anywhere else).
STAGE_APPROVER_LOGIN=

# Where evidence from e2e runs is written. Blank means <checkout>/.evidence (gitignored).
EVIDENCE_DIR=
# Source of the local pre-commit hook, for reinstalling it and for the operator clone.
PRECOMMIT_HOOK_SRC=
# Override the directory that holds the pinned tools (default in demo.env).
# TOOLS_BIN=

# --- the stage terminal (make demo-*; see docs/06-operations.md) ---
# Width the scene and speaker bars fill, in columns. Text is never wrapped to it: a long line
# wraps where the terminal wraps it. Blank: the terminal's own width. Set it only when the
# stage pane is narrower than the window.
DEMO_COLS=
# Command that opens a URL during the demo (split into words). Blank: xdg-open (open on macOS),
# the OS default browser. `google-chrome` opens a new tab in the Chrome window that is already
# running (on macOS: `open -b com.google.Chrome`); `true` opens nothing. The scenes open only new
# pages (a commit comment, a PR, its checks, a file); Argo CD and Grafana stay on their own tabs.
DEMO_OPEN=
# In talk pace every line of narration waits for Enter (line, the default). section types a
# whole narration section without stopping.
DEMO_STEP=
